; ComponentEngine for the playground's C++ -> WebAssembly build. glue.cpp
; exports `ce_eval`, which calls CeWasm.run; what the script prints goes to
; stdout, which the page's WASI shim collects.

Import "pkg:componentengine/ComponentEngine.rgr"

class CeWasm {
    sfn run:void (src:string) {
        def e (new ComponentEngine)
        e.quiet = true
        e.liveClock = true
        e.maxLoopIterations = 1000000000
        e.loadScript((src + "\nfunction __done__() { return 1; }\n"))
        e.callFunction("__done__" (EvHandle.null()))
    }

    sfn m@(main):void () {
        CeWasm.run("print(\"ready\")")
    }
}
